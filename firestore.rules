rules_version = '2';

// DNBingo Firestore rules.
// Kept in-repo as source of truth; mirror what's deployed in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{gameId} {
      // Anyone signed in (anonymous is fine) can read an active game.
      allow read: if request.auth != null;

      // Creating a game: the creator must be the host listed in the doc.
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;

      // Updates:
      //   - the host can change anything on their game
      //   - any signed-in player can join (add themselves to `players`)
      //     or update their own subfields (card, hasWon)
      //   - win claim transaction updates winner/winnerName/status
      allow update: if request.auth != null && (
        resource.data.hostId == request.auth.uid
        || request.auth.uid in request.resource.data.players
      );

      // Only the host can delete a game.
      allow delete: if request.auth != null
                    && resource.data.hostId == request.auth.uid;
    }
  }
}
